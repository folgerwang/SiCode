// Packed uint32 4x8-bit integer dot-product (VK_KHR_shader_integer_dot_product / DP4A) matvec for planar Q8_0.
// Each lane processes a full 32-element Q8 block (2x uvec4 = 8x packed int8x4 words) via 8x dotPacked4x8EXT.
// Variants: default (8 rows/WG, 1 subgroup/row), SWIGLU (silu(W1 x) * (W2 x)), WIDE (1 WG = 256 threads/row).
#version 460
#include "common.glsl"
#extension GL_EXT_integer_dot_product : require

layout(local_size_x = 256) in;
#define NT 8

layout(push_constant) uniform PC {
    uint64_t w1, s1, w2, s2, xq, xs, y;
    uint rows, cols, n, y_stride, post;
    float post_scale;
} pc;

int dp32(uvec4 wa, uvec4 wb, uvec4 xa, uvec4 xb) {
    int s = dotPacked4x8EXT(int(wa.x), int(xa.x));
    s += dotPacked4x8EXT(int(wa.y), int(xa.y));
    s += dotPacked4x8EXT(int(wa.z), int(xa.z));
    s += dotPacked4x8EXT(int(wa.w), int(xa.w));
    s += dotPacked4x8EXT(int(wb.x), int(xb.x));
    s += dotPacked4x8EXT(int(wb.y), int(xb.y));
    s += dotPacked4x8EXT(int(wb.z), int(xb.z));
    s += dotPacked4x8EXT(int(wb.w), int(xb.w));
    return s;
}

#ifdef WIDE
shared float red1[NT][8];

void main() {
    const uint tid = gl_LocalInvocationID.x, sg = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    const uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) return;
    const uint nblk = pc.cols >> 5;
    const uint nt = pc.n;

    U4 W1 = U4(pc.w1 + uint64_t(row) * pc.cols);
    F32 S1 = F32(pc.s1 + uint64_t(row) * nblk * 4u);

    float acc[NT];
    [[unroll]] for (uint t = 0; t < NT; t++) acc[t] = 0.0;

    for (uint b = tid; b < nblk; b += 256u) {
        const uvec4 w1a = W1.v[b * 2u], w1b = W1.v[b * 2u + 1u];
        const float sc1 = S1.v[b];
        [[unroll]] for (uint t = 0; t < NT; t++) {
            if (t >= nt) break;
            U4 X = U4(pc.xq + uint64_t(t) * pc.cols);
            const uvec4 xa = X.v[b * 2u], xb = X.v[b * 2u + 1u];
            const float xsc = F32(pc.xs).v[t * nblk + b];
            acc[t] = fma(float(dp32(w1a, w1b, xa, xb)), sc1 * xsc, acc[t]);
        }
    }
    [[unroll]] for (uint t = 0; t < NT; t++) {
        if (t >= nt) break;
        const float r = subgroupAdd(acc[t]);
        if (lane == 0u) red1[t][sg] = r;
    }
    barrier();
    if (sg == 0u && lane < nt) {
        float tot = 0.0;
        [[unroll]] for (uint i = 0; i < 8u; i++) tot += red1[lane][i];
        if (pc.post == 1u) tot = silu(tot * pc.post_scale);
        F32(pc.y + uint64_t(lane) * pc.y_stride * 4u).v[row] = tot;
    }
}
#else
void main() {
    const uint team = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    const uint row = gl_WorkGroupID.x * 8u + team;
    if (row >= pc.rows) return;
    const uint nblk = pc.cols >> 5;
    const uint nt = pc.n;

    U4 W1 = U4(pc.w1 + uint64_t(row) * pc.cols);
    F32 S1 = F32(pc.s1 + uint64_t(row) * nblk * 4u);
#ifdef SWIGLU
    U4 W2 = U4(pc.w2 + uint64_t(row) * pc.cols);
    F32 S2 = F32(pc.s2 + uint64_t(row) * nblk * 4u);
#endif

    float acc1[NT], acc2[NT];
    [[unroll]] for (uint t = 0; t < NT; t++) { acc1[t] = 0.0; acc2[t] = 0.0; }

    for (uint b = lane; b < nblk; b += 32u) {
        const uvec4 w1a = W1.v[b * 2u], w1b = W1.v[b * 2u + 1u];
        const float sc1 = S1.v[b];
#ifdef SWIGLU
        const uvec4 w2a = W2.v[b * 2u], w2b = W2.v[b * 2u + 1u];
        const float sc2 = S2.v[b];
#endif
        [[unroll]] for (uint t = 0; t < NT; t++) {
            if (t >= nt) break;
            U4 X = U4(pc.xq + uint64_t(t) * pc.cols);
            const uvec4 xa = X.v[b * 2u], xb = X.v[b * 2u + 1u];
            const float xsc = F32(pc.xs).v[t * nblk + b];
            acc1[t] = fma(float(dp32(w1a, w1b, xa, xb)), sc1 * xsc, acc1[t]);
#ifdef SWIGLU
            acc2[t] = fma(float(dp32(w2a, w2b, xa, xb)), sc2 * xsc, acc2[t]);
#endif
        }
    }
    [[unroll]] for (uint t = 0; t < NT; t++) {
        if (t >= nt) break;
        float r = subgroupAdd(acc1[t]);
#ifdef SWIGLU
        r = silu(r) * subgroupAdd(acc2[t]);
#endif
        if (lane == 0u) {
            if (pc.post == 1u) r = silu(r * pc.post_scale);
            F32(pc.y + uint64_t(t) * pc.y_stride * 4u).v[row] = r;
        }
    }
}
#endif
